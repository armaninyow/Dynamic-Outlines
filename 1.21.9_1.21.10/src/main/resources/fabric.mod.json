{
	"schemaVersion": 1,
	"id": "dynamicoutlines",
	"version": "${version}",
	"name": "Dynamic Outlines",
	"description": "Dynamically changes block and entity outline colors and patterns based on the item held in your main hand.",
	"authors": [
		"Armaninyow"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/dynamic-outlines",
		"sources": "https://github.com/armaninyow/Dynamic-Outlines",
		"issues": "https://github.com/armaninyow/Dynamic-Outlines/discussions/categories/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/dynamicoutlines/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.armaninyow.dynamicoutlines.DynamicOutlines"
		],
		"client": [
			"com.armaninyow.dynamicoutlines.DynamicOutlinesClient"
		],
		"modmenu": [
			"com.armaninyow.dynamicoutlines.config.DynamicOutlinesModMenuApi"
		]
	},
	"mixins": [
		{
			"config": "dynamicoutlines.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": ">=1.21.9 <1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"cloth-config": "*",
		"modmenu": "*"
	}
}